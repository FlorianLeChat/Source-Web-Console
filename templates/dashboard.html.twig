{# Modèle de base #}
{% extends "base.html.twig" %}

{# Injection de code JavaScript #}
{% block javascript %}
	<script>
		// Libellé demandant la suppression ou non du serveur actuel.
		window.edit_remove = "{{ t("dashboard.edit.remove")|trans|escape("js") }}";

		// Libellés demandant le changement de l'adresse IP/port et le mot de passe du serveur.
		window.edit_address = "{{ t("dashboard.edit.address")|trans|escape("js") }}";
		window.edit_port = "{{ t("dashboard.edit.port")|trans|escape("js") }}";
		window.edit_password = "{{ t("dashboard.edit.password")|trans|escape("js") }}";

		// Libellé indiquant l'interruption de la surveillance du serveur.
		window.monitor_interrupted = "{{ t("dashboard.state.interrupted")|trans|escape("js") }}";
	</script>
{% endblock %}

{# Contenu de la page demandé #}
{% block content %}
	{# Description de la page #}
	<p>{{ t("dashboard.description")|trans }}</p>

	{# Sélection des serveurs #}
	<section id="servers" data-route="{{ path("server_monitor") }}">
		{# Titre de la section #}
		<h2>{{ t("dashboard.servers")|trans }}</h2>

		<ul>
			{% for server in dashboard_servers %}
				{# Récupération de l'indice de la boucle #}
				{% set indice = loop.index %}

				{# Informations générales de chaque serveur #}
				<li data-image="{{ asset("build/images/games/" ~ (server.game ?? 0) ~ "_background.webp") }}" class="{{ indice > 4 ? "hidden" : "" }}">
					{# Construction de l'adresse IP #}
					{% set address = server.address ~ ":" ~ server.port %}

					{# Informations générales #}
					<span>{{ get_name_by_game_id(server.game, address) ~ " (" ~ loop.index ~ ")" }}</span>
					<span>{{ address }}</span>

					{# Édition des propriétés du serveur #}
					<form method="POST">
						<input type="hidden" name="id" value="{{ server.id }}" />
						<input type="hidden" name="token" value="{{ csrf_token("server_edit") }}">
						<input type="hidden" name="action" value="edit" />

						<button type="submit" name="server_edit" title="{{ t("global.update")|trans }}" aria-label="{{ t("global.update")|trans }}" data-address="{{ server.address }}" data-port="{{ server.port }}">
							<i class="bi bi-pencil-square"></i>
						</button>
					</form>

					{# Suppression du serveur #}
					<form method="POST">
						<input type="hidden" name="id" value="{{ server.id }}" />
						<input type="hidden" name="token" value="{{ csrf_token("server_delete") }}">
						<input type="hidden" name="action" value="delete" />

						<button type="submit" name="server_delete" title="{{ t("global.remove")|trans }}" aria-label="{{ t("global.remove")|trans }}">
							<i class="bi bi-trash3"></i>
						</button>
					</form>

					{# Connexion directe au serveur #}
					<form method="POST">
						<input type="hidden" name="id" value="{{ server.id }}" />
						<input type="hidden" name="token" value="{{ csrf_token("server_connect") }}">
						<input type="hidden" name="action" value="connect" />

						<button type="submit" name="server_connect" title="{{ t("dashboard.connect")|trans }}" aria-label="{{ t("dashboard.connect")|trans }}">
							<i class="bi bi-plug"></i>
						</button>
					</form>
				</li>
			{% endfor %}
		</ul>

		{# Nombre de pages de serveurs #}
		{% set pages = max(dashboard_servers|length / 4, 1)|round(0, "ceil") %}

		<button type="button" {{ pages <= 1 ? "disabled" : "" }} title="{{ t("index.feature.previous")|trans }}" aria-label="{{ t("index.feature.previous")|trans }}">
			{# Serveurs précédents #}
			<i class="bi bi-chevron-left"></i>
		</button>

		<span>1 / {{ pages }}</span>

		<button type="button" {{ pages <= 1 ? "disabled" : "" }} title="{{ t("index.feature.next")|trans }}" aria-label="{{ t("index.feature.next")|trans }}">
			{# Serveurs suivants #}
			<i class="bi bi-chevron-right"></i>
		</button>
	</section>

	{# État général #}
	<section id="state">
		{# Titre de la section #}
		<h3>{{ t("dashboard.state.title")|trans }}</h3>

		<ul>
			<li>
				{# Informations d'état #}
				<div class="circle"></div>
				<h4>{{ t("dashboard.state.info")|trans }}</h4>
				<em data-field="state">{{ t("dashboard.state.nodata")|trans|raw }}</em>
			</li>

			<li>
				{# Nom de la carte actuelle #}
				<div class="circle"></div>
				<h4>{{ t("dashboard.state.map")|trans }}</h4>
				<em data-field="map">gm_source</em>
			</li>

			<li>
				{# Nombre de joueurs (robots compris) #}
				<div class="circle"></div>
				<h4>{{ t("dashboard.state.players")|trans }}</h4>
				<em data-field="players">0 / 0 [0]</em>
			</li>
		</ul>

		{# Relance de la surveillance après une erreur #}
		<button type="button" data-action="retry" hidden>{{ t("dashboard.state.retry")|trans }}</button>
	</section>

	{# Liste des joueurs #}
	<section id="players">
		{# Titre de la section #}
		<h3>{{ t("dashboard.players")|trans }}</h3>

		{# Détails des joueurs #}
		<ul data-empty="{{ t("dashboard.players_empty")|trans }}"></ul>
	</section>

	{# Actions rapides #}
	<section id="actions">
		{# Titre de la section #}
		<h3>{{ t("header.search.title")|trans }}</h3>

		<ul>
			<li>
				{# Arrêter le serveur #}
				<button type="button" data-action="shutdown" data-confirm data-token="{{ csrf_token("server_shutdown") }}" data-route="{{ path("server_action") }}">{{ t("global.shutdown")|trans }}</button>
				<button type="button" data-action="force" data-confirm data-token="{{ csrf_token("server_force") }}" data-route="{{ path("server_action") }}">{{ t("global.force")|trans }}</button>
			</li>

			<li>
				{# Redémarrer le serveur #}
				<button type="button" data-action="restart" data-confirm data-token="{{ csrf_token("server_restart") }}" data-route="{{ path("server_action") }}">{{ t("global.restart")|trans }}</button>
			</li>

			<li>
				{# Mettre à jour le serveur #}
				<button type="button" data-action="update" data-confirm data-token="{{ csrf_token("server_update") }}" data-route="{{ path("server_action") }}">{{ t("global.update")|trans }}</button>
			</li>

			<li>
				{# Passer en mode de maintenance #}
				<button type="button" data-action="service" data-token="{{ csrf_token("server_service") }}" data-route="{{ path("server_action") }}">{{ t("global.service")|trans }}</button>
			</li>
		</ul>
	</section>

	{# Dernière action réalisée #}
	<section id="last">
		{# Titre de la section #}
		<h3>{{ t("dashboard.actions")|trans }}</h3>

		{# Nom des dernières tâches (descendantes) #}
		<ul data-empty="{{ t("dashboard.actions_empty")|trans }}">
			{%- for logs in dashboard_logs -%}
				<li>
					{# Icône représentative de la tâche #}
					<i class="bi bi-check-square-fill" data-type="{{ logs.action }}"></i>

					{# Heure de l'actionnement #}
					<span>{{ logs.date|date("H:i:s (d/m)") }}</span>

					{# Titre de l'action #}
					{% set console = t("header.subtitle.console")|trans %}
					<em>{{ logs.action == "console" ? console : t("global." ~ logs.action)|trans|default(logs.action|capitalize) }}</em>
				</li>
			{%- endfor -%}
		</ul>
	</section>
{% endblock %}