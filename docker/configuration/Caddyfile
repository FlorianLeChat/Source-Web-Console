{
    admin off
    auto_https off

    frankenphp {
        num_threads 4
    }

    servers {
        enable_full_duplex
    }
}

:8080 {
    encode zstd br gzip
    file_server

    log {
        output stdout
        format console
    }

    header {
        -Server
        -X-Powered-By
    }

    php_server {
        resolve_root_symlink

        try_files {path} index.php

        root /var/www/html/public

        worker {
            env FRANKENPHP_LOOP_MAX 500
            num 2
            file /var/www/html/public/index.php
        }
    }
}
